{
  "name": "the-gilded-skin",
  "version": "1.0.0",
  "private": true,
  "description": "The Gilded Skin \u2014 an independent beauty editorial publication.",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit:content": "tsx scripts/audit-content.ts",
    "audit:links": "tsx scripts/audit-links.ts",
    "content:new": "tsx scripts/new-article.ts",
    "content:brief": "tsx scripts/new-brief.ts",
    "pinterest:export": "tsx scripts/export-pins.ts",
    "brand:assets": "tsx scripts/generate-brand-assets.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run audit:content && npm run audit:links && npm run build",
    "audit:launch": "tsx scripts/audit-content.ts --launch"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "next": "^15.5.27",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "reading-time": "^1.5.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.27",
    "postcss": "^8.5.29",
    "sharp": "^0.35.5",
    "tailwindcss": "3.4",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^3.2.7"
  }
}
