# ---------------------------------------------------------------------------
# The Gilded Skin — environment configuration
# Copy to .env.local for development. Configure the same keys in your host's
# dashboard for production. Never commit real secrets.
# ---------------------------------------------------------------------------

# Canonical production origin (no trailing slash). Public by design.
NEXT_PUBLIC_SITE_URL=https://thegildedskin.com

# "production" enables indexing. Anything else (staging, preview, development)
# makes robots.txt disallow everything and sends noindex on every page.
SITE_ENV=development

# Amazon US Associates tracking ID. Read on the server only. Not a secret, but
# kept out of client bundles so it can be changed in one place.
AMAZON_ASSOCIATE_TAG=gettse00-20
# Amazon marketplace host used when building affiliate links.
AMAZON_MARKETPLACE=www.amazon.com

# Contact address shown on the Contact page and legal pages. Set to a real,
# monitored mailbox before launch.
CONTACT_EMAIL=

# --- Contact form email delivery (optional) --------------------------------
# If unset, the form validates input but tells visitors to email directly.
# Supported: "resend". RESEND_API_KEY is a secret — server only.
CONTACT_PROVIDER=
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# --- Newsletter (optional) --------------------------------------------------
# A provider's hosted form POST endpoint. The signup block is hidden unless set.
NEWSLETTER_FORM_ACTION=
NEWSLETTER_PROVIDER_NAME=

# --- Verification tokens (paste values from each dashboard) ----------------
GOOGLE_SITE_VERIFICATION=
PINTEREST_SITE_VERIFICATION=

# --- Analytics (optional, consent-gated) ------------------------------------
# GA4 measurement ID, e.g. G-XXXXXXXXXX. Loaded only after visitor consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Editorial studio --------------------------------------------------------
# The read-only /studio dashboard is available in development only. Set to
# "true" to expose it on a password-protected preview deployment. Never enable
# on the public production site.
ENABLE_STUDIO=

# --- Social profiles (optional, shown in footer + Organization schema) ------
NEXT_PUBLIC_PINTEREST_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
